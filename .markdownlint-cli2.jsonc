// The family's one Markdown form, as rules. It sits at the repository root under the name
// markdownlint-cli2 and the editor plugins built on it look for, because a form held in CI and
// not in the editor is a form a writer meets only after pushing. conventions-format names this
// file explicitly and an editor finds it without being told; both read these bytes, so a file
// saved in an editor and a file written by `conventions-format fix` come out the same.
//
// The paragraph these rules enforce is the Markdown paragraph of conventions/WRITING.md, and the
// one rule markdownlint does not ship is conventions/markdown-rules.cjs beside them. Edit either
// in robertblust/conventions and never in a member: conventions-sync vendors both and
// conventions-check holds every copy to the release.
{
  "config": {
    "default": false,
    "MD004": { "style": "dash" },
    "MD009": true,
    "MD010": { "code_blocks": false },
    "MD012": true,
    "MD047": true,
    "MD049": { "style": "asterisk" },
    "MD050": { "style": "asterisk" },
    "MD055": { "style": "leading_and_trailing" },
    "MD060": { "style": "compact" },
    "table-delimiter-row": true
  },
  "customRules": ["./conventions/markdown-rules.cjs"]
}
